// ============================================================
// مخطط قاعدة البيانات - نظام إدارة مكتبة الملازم الدراسية
// المرحلة 1: الأساس + قابلية التوسع المستقبلي
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// المستخدمون والصلاحيات
// ------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
}

model User {
  id           String   @id @default(cuid())
  role         Role
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher Teacher? // موجود فقط إذا كان role = TEACHER

  @@map("users")
}

model Teacher {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  phone            String
  // نسبة الأرباح الافتراضية لهذا الأستاذ، يمكن تخصيصها لكل ملزمة على حدة
  profitPercentage Decimal  @default(30) @db.Decimal(5, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booklets Booklet[]
  orders   Order[]

  @@map("teachers")
}

// ------------------------------------------------------------
// التصنيفات
// ------------------------------------------------------------

model Subject {
  id   String @id @default(cuid())
  name String @unique

  booklets Booklet[]

  @@map("subjects")
}

model Stage {
  id   String @id @default(cuid())
  name String @unique

  booklets Booklet[]

  @@map("stages")
}

// المحافظات/المدن: النظام يعمل حاليًا بمحافظة واحدة فقط،
// لكن الجدول مصمم مسبقًا حتى يمكن إضافة أكثر من محافظة لاحقًا
// دون أي تعديل على البنية أو الكود الأساسي.
model Governorate {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  orders Order[]

  @@map("governorates")
}

// ------------------------------------------------------------
// الملازم
// ------------------------------------------------------------

enum BookletStatus {
  VISIBLE
  HIDDEN
}

model Booklet {
  id            String        @id @default(cuid())
  title         String
  coverImageUrl String?
  description   String?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  price Decimal @db.Decimal(10, 2)

  // إذا كانت فارغة يتم استخدام profitPercentage الخاصة بالأستاذ كقيمة افتراضية
  teacherProfitPercentageOverride Decimal? @db.Decimal(5, 2)

  status     BookletStatus @default(VISIBLE)
  salesCount Int           @default(0) // مجموع محسوب مسبقًا لتسريع الواجهة

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([subjectId])
  @@index([stageId])
  @@index([status])
  @@map("booklets")
}

// ------------------------------------------------------------
// الطلبات
// ------------------------------------------------------------

enum OrderStatus {
  NEW
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id String @id @default(cuid())

  bookletId String
  booklet   Booklet @relation(fields: [bookletId], references: [id])

  // نسخ teacherId وقت الطلب: يضمن بقاء التقارير صحيحة حتى لو تغيّر
  // الأستاذ المسؤول عن الملزمة لاحقًا
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  studentName  String
  studentPhone String

  // اختياري في النسخة الحالية لأن المكتبة تخدم محافظة واحدة فقط،
  // لكنه موجود مسبقًا لدعم التوسع دون تعديل البنية
  governorateId  String?
  governorate    Governorate? @relation(fields: [governorateId], references: [id])
  addressDetails String?

  notes String?

  // نسخة من السعر وقت الطلب لضمان دقة السجل التاريخي
  priceAtOrder Decimal @db.Decimal(10, 2)

  status OrderStatus @default(NEW)

  profitSnapshot ProfitSnapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([bookletId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// لقطة أرباح محسوبة وقت إتمام الطلب (لا تتغير بأثر رجعي عند تعديل النسب لاحقًا)
model ProfitSnapshot {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  teacherShare Decimal @db.Decimal(10, 2)
  libraryShare Decimal @db.Decimal(10, 2)

  calculatedAt DateTime @default(now())

  @@map("profit_snapshots")
}

// ------------------------------------------------------------
// الإشعارات
// ------------------------------------------------------------

model Notification {
  id           String   @id @default(cuid())
  type         String // مثال: "new_order"
  message      String
  isRead       Boolean  @default(false)
  targetRole   Role? // إشعار موجّه لكل الأدمن مثلًا
  targetUserId String? // أو لمستخدم محدد
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([targetRole])
  @@map("notifications")
}

// ------------------------------------------------------------
// إعدادات عامة للنظام (اسم المكتبة، الشعار، إلخ) - يعدّلها الأدمن من لوحة التحكم
// ------------------------------------------------------------

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}
